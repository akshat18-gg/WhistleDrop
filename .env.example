# Both secrets must be at least 32 characters. Generate each one with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
CASE_CODE_SECRET=

# Encrypts report descriptions and evidence links in the database. Make one with:
#   python3 -c "import base64, os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# If you lose it, the stored reports can't be read any more.
ENCRYPTION_KEY=

DATABASE_URL=sqlite:///./whistledrop.db
